# Core server configuration
SECRET_KEY=
DATABASE_URL=
AUTH_REQUIRED=1

# Sign in with Apple (values belong in the deployment secret store)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_REQUIRE_CODE_EXCHANGE=1

# Existing server-side AI provider configuration
GEMINI_API_KEY=
GEMINI_MODEL=
AI_ROUTER_MODEL=
AI_FAST_MODEL=
AI_DEFAULT_MODEL=
AI_HARD_MODEL=
MAX_PDF_UPLOAD_BYTES=67108864
MAX_PDF_PAGES=100
MAX_PDF_PAGE_DIMENSION=100000
PDF_PREVIEW_MAX_EDGE=2048

# Per-account abuse/cost controls: request count and fixed window in seconds.
RATE_LIMIT_LOGIN_COUNT=12
RATE_LIMIT_LOGIN_WINDOW=300
RATE_LIMIT_UPLOAD_COUNT=30
RATE_LIMIT_UPLOAD_WINDOW=3600
RATE_LIMIT_EXPLAIN_COUNT=120
RATE_LIMIT_EXPLAIN_WINDOW=3600
RATE_LIMIT_PRACTICE_COUNT=60
RATE_LIMIT_PRACTICE_WINDOW=3600
RATE_LIMIT_CHECK_WORK_COUNT=120
RATE_LIMIT_CHECK_WORK_WINDOW=3600
RATE_LIMIT_STUDY_GUIDE_COUNT=30
RATE_LIMIT_STUDY_GUIDE_WINDOW=3600
